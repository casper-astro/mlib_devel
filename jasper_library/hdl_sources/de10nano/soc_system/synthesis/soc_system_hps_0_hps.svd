          <name>NotLast</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>SingleOrLast</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>TxRqst</name>
       <description>Transmit Request</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>can_msgifgrp_IF1MCTR_TxRqst_enum</name>
