         <enumeratedValue>
          <name>end</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>begin</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>all</name>
          <value>3</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>compsplt</name>
