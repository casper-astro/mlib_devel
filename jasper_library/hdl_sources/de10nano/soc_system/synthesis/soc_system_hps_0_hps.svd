     <access>read-only</access>
     <resetValue>0x44570140</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>ic_comp_type</name>
       <description>Designware Component Type number = 0x44_57_01_40. This assigned unique hex value is constant and is derived from the two ASCII letters 'DW' followed by a 16-bit unsigned number.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
   </registers>
  </peripheral>
  <peripheral>
   <name>sptimer0</name>
   <version>0.0</version>
   <description>Registers in the timer module. The timer IP core supports multiple timers but it is configured for just one timer. The term Timer1 refers to this one timer in the IP core and not the module instance.</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_permodrst-&gt;sptimer0 == 1)</disableCondition><baseAddress>0xffc08000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0xb0</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>timer1loadcount</name>
     <description>Used to load counter value into Timer1</description>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1loadcount</name>
       <description>Value to be loaded into Timer1. This is the value from which counting commences. Any value written to this register is loaded into the associated timer.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1currentval</name>
     <description>Provides current value of Timer1</description>
     <addressOffset>0x4</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1currentval</name>
       <description>Current value of Timer1.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1controlreg</name>
     <description>This register controls enabling, operating mode (free-running or user-defined-count), and interrupt mask of Timer1. You can program this register to enable or disable Timer1 and to control its mode of operation.</description>
     <addressOffset>0x8</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1_enable</name>
       <description>Timer1 enable/disable bit.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>timer_timer1controlreg_timer1_enable_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>timer1_mode</name>
       <description>Sets operating mode.
NOTE: You must set the timer1loadcount register to all ones before enabling the timer in free-running mode.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>timer_timer1controlreg_timer1_mode_enum</name>
         <enumeratedValue>
          <name>freerun</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>usedef</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>timer1_interrupt_mask</name>
       <description>Timer1 interrupt mask</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>timer_timer1controlreg_timer1_interrupt_mask_enum</name>
         <enumeratedValue>
          <name>notmasked</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>masked</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1eoi</name>
     <description>Clears Timer1 interrupt when read.</description>
     <addressOffset>0xc</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1eoi</name>
       <description>Reading from this register clears the interrupt from Timer1 and returns 0.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1intstat</name>
     <description>Provides the interrupt status of Timer1 after masking.</description>
     <addressOffset>0x10</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1intstat</name>
       <description>Provides the interrupt status for Timer1. The status reported is after the interrupt mask has been applied. Reading from this register does not clear any active interrupts.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>timer_timer1intstat_timer1intstat_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timersintstat</name>
     <description>Provides the interrupt status for all timers after masking. Because there is only Timer1 in this module instance, this status is the same as timer1intstat.</description>
     <addressOffset>0xa0</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timersintstat</name>
       <description>Provides the interrupt status for Timer1. Because there is only Timer1 in this module instance, this status is the same as timer1intstat. The status reported is after the interrupt mask has been applied. Reading from this register does not clear any active interrupts.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>timer_timersintstat_timersintstat_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timerseoi</name>
     <description>Clears Timer1 interrupt when read. Because there is only Timer1 in this module instance, reading this register has the same effect as reading timer1eoi.</description>
     <addressOffset>0xa4</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timerseoi</name>
       <description>Reading from this register clears the interrupt all timers and returns 0. Because there is only Timer1 in this module instance, reading this register has the same effect as reading timer1eoi.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timersrawintstat</name>
     <description>Provides the interrupt status for all timers before masking. Note that there is only Timer1 in this module instance.</description>
     <addressOffset>0xa8</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timersrawintstat</name>
       <description>Provides the interrupt status for Timer1. Because there is only Timer1 in this module instance, this status is the same as timer1intstat. The status reported is before the interrupt mask has been applied. Reading from this register does not clear any active interrupts.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>timer_timersrawintstat_timersrawintstat_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timerscompversion</name>
     <addressOffset>0xac</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x3230352a</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timerscompversion</name>
       <description>Current revision number of the timers component.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
   </registers>
  </peripheral>
  <peripheral>
   <name>sptimer1</name>
   <version>0.0</version>
   <description>Registers in the timer module. The timer IP core supports multiple timers but it is configured for just one timer. The term Timer1 refers to this one timer in the IP core and not the module instance.</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_permodrst-&gt;sptimer1 == 1)</disableCondition><baseAddress>0xffc09000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0xb0</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>timer1loadcount</name>
     <description>Used to load counter value into Timer1</description>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1loadcount</name>
       <description>Value to be loaded into Timer1. This is the value from which counting commences. Any value written to this register is loaded into the associated timer.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1currentval</name>
     <description>Provides current value of Timer1</description>
     <addressOffset>0x4</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1currentval</name>
       <description>Current value of Timer1.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1controlreg</name>
     <description>This register controls enabling, operating mode (free-running or user-defined-count), and interrupt mask of Timer1. You can program this register to enable or disable Timer1 and to control its mode of operation.</description>
     <addressOffset>0x8</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1_enable</name>
       <description>Timer1 enable/disable bit.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>timer_timer1controlreg_timer1_enable_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>timer1_mode</name>
       <description>Sets operating mode.
NOTE: You must set the timer1loadcount register to all ones before enabling the timer in free-running mode.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>timer_timer1controlreg_timer1_mode_enum</name>
         <enumeratedValue>
          <name>freerun</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>usedef</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>timer1_interrupt_mask</name>
       <description>Timer1 interrupt mask</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>timer_timer1controlreg_timer1_interrupt_mask_enum</name>
         <enumeratedValue>
          <name>notmasked</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>masked</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1eoi</name>
     <description>Clears Timer1 interrupt when read.</description>
     <addressOffset>0xc</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1eoi</name>
       <description>Reading from this register clears the interrupt from Timer1 and returns 0.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timer1intstat</name>
     <description>Provides the interrupt status of Timer1 after masking.</description>
     <addressOffset>0x10</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timer1intstat</name>
       <description>Provides the interrupt status for Timer1. The status reported is after the interrupt mask has been applied. Reading from this register does not clear any active interrupts.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>timer_timer1intstat_timer1intstat_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timersintstat</name>
     <description>Provides the interrupt status for all timers after masking. Because there is only Timer1 in this module instance, this status is the same as timer1intstat.</description>
     <addressOffset>0xa0</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timersintstat</name>
       <description>Provides the interrupt status for Timer1. Because there is only Timer1 in this module instance, this status is the same as timer1intstat. The status reported is after the interrupt mask has been applied. Reading from this register does not clear any active interrupts.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>timer_timersintstat_timersintstat_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timerseoi</name>
     <description>Clears Timer1 interrupt when read. Because there is only Timer1 in this module instance, reading this register has the same effect as reading timer1eoi.</description>
     <addressOffset>0xa4</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timerseoi</name>
       <description>Reading from this register clears the interrupt all timers and returns 0. Because there is only Timer1 in this module instance, reading this register has the same effect as reading timer1eoi.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>timersrawintstat</name>
     <description>Provides the interrupt status for all timers before masking. Note that there is only Timer1 in this module instance.</description>
     <addressOffset>0xa8</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timersrawintstat</name>
       <description>Provides the interrupt status for Timer1. Because there is only Timer1 in this module instance, this status is the same as timer1intstat. The status reported is before the interrupt mask has been applied. Reading from this register does not clear any active interrupts.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>timer_timersrawintstat_timersrawintstat_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>timerscompversion</name>
     <addressOffset>0xac</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x3230352a</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>timerscompversion</name>
       <description>Current revision number of the timers component.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
   </registers>
  </peripheral>
  <peripheral>
   <name>sdr</name>
   <version>0.0</version>
   <description>Address map for the SDRAM Interface registers</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_permodrst-&gt;sdr == 1)</disableCondition><baseAddress>0xffc20000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0x20000</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>ctrlgrp_ctrlcfg</name>
     <description>The Controller Configuration Register determines the behavior of the controller. </description>
     <addressOffset>0x5000</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xf8000000</resetMask>
     <fields>
      <field>
       <name>memtype</name>
       <description>Selects memory type. Program this field with one of the following binary values, &amp;quot;001&amp;quot; for DDR2 SDRAM, &amp;quot;010&amp;quot; for DDR3 SDRAM, &amp;quot;011&amp;quot; for LPDDR1 SDRAM or &amp;quot;100&amp;quot; for LPDDR2 SDRAM.</description>
       <lsb>0</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>membl</name>
       <description>Configures burst length as a static decimal value.  Legal values are valid for JEDEC allowed DRAM values for the DRAM selected in cfg_type.  For DDR3, this should be programmed with 8 (binary &amp;quot;01000&amp;quot;), for DDR2 it can be either 4 or 8 depending on the exact DRAM chip.  LPDDR2 can be programmed with 4, 8, or 16 and LPDDR can be programmed with 2, 4, or 8. You must also program the membl field in the staticcfg register.</description>
       <lsb>3</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>addrorder</name>
       <description>Selects the order for address interleaving.  Programming this field with different values gives different mappings between the AXI or Avalon-MM address and the SDRAM address. Program this field with the following binary values to select the ordering. &amp;quot;00&amp;quot; - chip, row, bank, column, &amp;quot;01&amp;quot; - chip, bank, row, column, &amp;quot;10&amp;quot;-row, chip, bank, column</description>
       <lsb>8</lsb>
       <msb>9</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>eccen</name>
       <description>Enable the generation and checking of ECC.  This bit must only be set if the memory connected to the SDRAM interface is 24 or 40 bits wide. If you set this, you must clear the useeccasdata field in the staticcfg register.</description>
       <lsb>10</lsb>
       <msb>10</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>ecccorren</name>
       <description>Enable auto correction of the read data returned when single bit error is detected.</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>cfg_enable_ecc_code_overwrites</name>
       <description>Set to a one to enable ECC overwrites.  ECC overwrites occur when a correctable ECC error is seen and cause a new read/modify/write to be scheduled for that location to clear the ECC error.</description>
       <lsb>12</lsb>
       <msb>12</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>gensbe</name>
       <description>Enable the deliberate insertion of single bit errors in data written to memory. This should only be used for testing purposes.</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>gendbe</name>
       <description>Enable the deliberate insertion of double bit errors in data written to memory. This should only be used for testing purposes.</description>
       <lsb>14</lsb>
       <msb>14</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>reorderen</name>
       <description>This bit controls whether the controller can re-order operations to optimize SDRAM bandwidth.  It should generally be set to a one.</description>
       <lsb>15</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>starvelimit</name>
       <description>Specifies the number of DRAM burst transactions an individual transaction will allow to reorder ahead of it before its priority is raised in the memory controller.</description>
       <lsb>16</lsb>
       <msb>21</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>dqstrken</name>
       <description>Enables DQS tracking in the PHY.</description>
       <lsb>22</lsb>
       <msb>22</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>nodmpins</name>
       <description>Set to a one to enable DRAM operation if no DM pins are connected.</description>
       <lsb>23</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>burstintren</name>
       <description>Set to a one to enable the controller to issue burst interrupt commands. This must only be set when the DRAM memory type is LPDDR2.</description>
       <lsb>24</lsb>
       <msb>24</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>bursttermen</name>
       <description>Set to a one to enable the controller to issue burst terminate commands. This must only be set when the DRAM memory type is LPDDR2.</description>
       <lsb>25</lsb>
       <msb>25</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramtiming1</name>
     <description>This register implements JEDEC standardized timing parameters.  It should be programmed in clock cycles, for the value specified by the memory vendor. </description>
     <addressOffset>0x5004</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <fields>
      <field>
       <name>tcwl</name>
       <description>Memory write latency.</description>
       <lsb>0</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tal</name>
       <description>Memory additive latency.</description>
       <lsb>4</lsb>
       <msb>8</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tcl</name>
       <description>Memory read latency.</description>
       <lsb>9</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>trrd</name>
       <description>The activate to activate, different banks timing parameter.</description>
       <lsb>14</lsb>
       <msb>17</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tfaw</name>
       <description>The four-activate window timing parameter.</description>
       <lsb>18</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>trfc</name>
       <description>The refresh cycle timing parameter.</description>
       <lsb>24</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramtiming2</name>
     <description>This register implements JEDEC standardized timing parameters.  It should be programmed in clock cycles, for the value specified by the memory vendor. </description>
     <addressOffset>0x5008</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xe0000000</resetMask>
     <fields>
      <field>
       <name>trefi</name>
       <description>The refresh interval timing parameter.</description>
       <lsb>0</lsb>
       <msb>12</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>trcd</name>
       <description>The activate to read/write timing parameter.</description>
       <lsb>13</lsb>
       <msb>16</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>trp</name>
       <description>The precharge to activate timing parameter.</description>
       <lsb>17</lsb>
       <msb>20</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>twr</name>
       <description>The write recovery timing.</description>
       <lsb>21</lsb>
       <msb>24</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>twtr</name>
       <description>The write to read timing parameter.</description>
       <lsb>25</lsb>
       <msb>28</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramtiming3</name>
     <description>This register implements JEDEC standardized timing parameters.  It should be programmed in clock cycles, for the value specified by the memory vendor. </description>
     <addressOffset>0x500c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xff800000</resetMask>
     <fields>
      <field>
       <name>trtp</name>
       <description>The read to precharge timing parameter.</description>
       <lsb>0</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tras</name>
       <description>The activate to precharge timing parameter.</description>
       <lsb>4</lsb>
       <msb>8</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>trc</name>
       <description>The activate to activate timing parameter.</description>
       <lsb>9</lsb>
       <msb>14</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tmrd</name>
       <description>Mode register timing parameter.</description>
       <lsb>15</lsb>
       <msb>18</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tccd</name>
       <description>The CAS to CAS delay time.</description>
       <lsb>19</lsb>
       <msb>22</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramtiming4</name>
     <description>This register implements JEDEC standardized timing parameters.  It should be programmed in clock cycles, for the value specified by the memory vendor. </description>
     <addressOffset>0x5010</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xff000000</resetMask>
     <fields>
      <field>
       <name>selfrfshexit</name>
       <description>The self refresh exit cycles, tXS.</description>
       <lsb>0</lsb>
       <msb>9</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>pwrdownexit</name>
       <description>The power down exit cycles, tXPDLL.</description>
       <lsb>10</lsb>
       <msb>19</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>minpwrsavecycles</name>
       <description>The minimum number of cycles to stay in a low power state. This applies to both power down and self-refresh and should be set to the greater of tPD and tCKESR.</description>
       <lsb>20</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_lowpwrtiming</name>
     <description>This register controls the behavior of the low power logic in the controller. </description>
     <addressOffset>0x5014</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfff00000</resetMask>
     <fields>
      <field>
       <name>autopdcycles</name>
       <description>The number of idle clock cycles after which the controller should place the memory into power-down mode.</description>
       <lsb>0</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>clkdisablecycles</name>
       <description>Set to a the number of clocks after the execution of an self-refresh to stop the clock.  This register is generally set based on PHY design latency and should generally not be changed.</description>
       <lsb>16</lsb>
       <msb>19</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramodt</name>
     <description>This register controls which ODT pin is asserted during reads or writes. Bits [1:0] control which ODT pin is asserted during to accesses to chip select 0, bits [3:2] which ODT pin is asserted during accesses to chip select 1. For example, a value of &amp;quot;1001&amp;quot; will cause ODT[0] to be asserted for accesses to CS[0], and ODT[1] to be asserted for access to CS[1] pin. Set this to &amp;quot;0001&amp;quot; if there is only one chip select available. </description>
     <addressOffset>0x5018</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff00</resetMask>
     <fields>
      <field>
       <name>cfg_write_odt_chip</name>
       <description>This register controls which ODT pin is asserted during writes.</description>
       <lsb>0</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>cfg_read_odt_chip</name>
       <description>This register controls which ODT pin is asserted during reads.</description>
       <lsb>4</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramaddrw</name>
     <description>This register configures the width of the various address fields of the DRAM.  The values specified in this register must match the memory devices being used. </description>
     <addressOffset>0x502c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffff0000</resetMask>
     <fields>
      <field>
       <name>colbits</name>
       <description>The number of column address bits for the memory devices in your memory interface.</description>
       <lsb>0</lsb>
       <msb>4</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>rowbits</name>
       <description>The number of row address bits for the memory devices in your memory interface.</description>
       <lsb>5</lsb>
       <msb>9</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>bankbits</name>
       <description>The number of bank address bits for the memory devices in your memory interface.</description>
       <lsb>10</lsb>
       <msb>12</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>csbits</name>
       <description>The number of chip select address bits for the memory devices in your memory interface.</description>
       <lsb>13</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramifwidth</name>
     <description> </description>
     <addressOffset>0x5030</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff00</resetMask>
     <fields>
      <field>
       <name>ifwidth</name>
       <description>This register controls the interface width of the SDRAM interface, including any bits used for ECC. For example, for a 32-bit interface with ECC, program this register with 0x28. You must also program the ctrlwidth register.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramdevwidth</name>
     <description> </description>
     <addressOffset>0x5034</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffff0</resetMask>
     <fields>
      <field>
       <name>devwidth</name>
       <description>This register specifies the width of the physical DRAM chips, for example 8 or 16.</description>
       <lsb>0</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramsts</name>
     <description>This register provides the status of the calibration and ECC logic. </description>
     <addressOffset>0x5038</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffe0</resetMask>
     <fields>
      <field>
       <name>calsuccess</name>
       <description>This bit will be set to 1 if the PHY was able to successfully calibrate.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>calfail</name>
       <description>This bit  will be set to 1 if the PHY was unable to calibrate.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>sbeerr</name>
       <description>This bit will be set to 1 if there have been any ECC single bit errors detected.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>dbeerr</name>
       <description>This bit will be set to 1 if there have been any ECC double bit errors detected.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>corrdrop</name>
       <description>This bit will be set to 1 if there any auto-corrections have been dropped.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dramintr</name>
     <description> </description>
     <addressOffset>0x503c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffe0</resetMask>
     <fields>
      <field>
       <name>intren</name>
       <description>Enable the interrupt output.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>sbemask</name>
       <description>Mask the single bit error interrupt.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>dbemask</name>
       <description>Mask the double bit error interrupt.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>corrdropmask</name>
       <description>Set this bit to a one to mask interrupts for an ECC correction write back needing to be dropped.  This indicates a burst of memory errors in a short period of time.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>intrclr</name>
       <description>Writing to this self-clearing bit clears the interrupt signal. Writing to this bit also clears the error count and error address registers.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_sbecount</name>
     <description> </description>
     <addressOffset>0x5040</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff00</resetMask>
     <fields>
      <field>
       <name>count</name>
       <description>Reports the number of single bit errors that have occurred since the status register counters were last cleared.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dbecount</name>
     <description> </description>
     <addressOffset>0x5044</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff00</resetMask>
     <fields>
      <field>
       <name>count</name>
       <description>Reports the number of double bit errors that have occurred since the status register counters were last cleared.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_erraddr</name>
     <description> </description>
     <addressOffset>0x5048</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <fields>
      <field>
       <name>addr</name>
       <description>The address of the most recent ECC error.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dropcount</name>
     <description> </description>
     <addressOffset>0x504c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff00</resetMask>
     <fields>
      <field>
       <name>corrdropcount</name>
       <description>This gives the count of the number of ECC write back transactions dropped due to the internal FIFO overflowing.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_dropaddr</name>
     <description> </description>
     <addressOffset>0x5050</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <fields>
      <field>
       <name>corrdropaddr</name>
       <description>This register gives the last address which was dropped.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_lowpwreq</name>
     <description>This register instructs the controller to put the DRAM into a power down state.  Note that some commands are only valid for certain memory types. </description>
     <addressOffset>0x5054</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffc0</resetMask>
     <fields>
      <field>
       <name>deeppwrdnreq</name>
       <description>Write a one to this bit to request a deep power down.  This bit should only be written with LPDDR2 DRAMs, DDR3 DRAMs do not support deep power down.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>deeppwrdnmask</name>
       <description>Write ones to this register to select which DRAM chip selects will be powered down.  Typical usage is to set both of these bits when deeppwrdnreq is set but the controller does support putting a single chip into deep power down and keeping the other chip running.</description>
       <lsb>1</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>selfrshreq</name>
       <description>Write a one to this bit to request the RAM be put into a self refresh state.  This bit is treated as a static value so the RAM will remain in self-refresh as long as this register bit is set to a one.  This power down mode can be selected for all DRAMs supported by the controller.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>selfrfshmask</name>
       <description>Write a one to each bit of this field to have a self refresh request apply to both chips.</description>
       <lsb>4</lsb>
       <msb>5</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_lowpwrack</name>
     <description>This register gives the status of the power down commands requested by the Low Power Control register. </description>
     <addressOffset>0x5058</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffffc</resetMask>
     <fields>
      <field>
       <name>deeppwrdnack</name>
       <description>This bit is set to a one after a deep power down has been executed</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>selfrfshack</name>
       <description>This bit is a one to indicate that the controller is in a self-refresh state.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_staticcfg</name>
     <description>This register controls configuration values which cannot be updated while transactions are flowing. 
 You should write once to this register with the membl and eccen fields set to your desired configuration, and then write to the register again with membl and eccen and the applycfg bit set. The applycfg bit is write only.</description>
     <addressOffset>0x505c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffff0</resetMask>
     <fields>
      <field>
       <name>membl</name>
       <description>This field specifies the DRAM burst length. Write the following values to set the a burst length appropriate for the specific DRAM being used. &amp;quot;00&amp;quot; for burst length 2, &amp;quot;01&amp;quot; for burst length 4, &amp;quot;10&amp;quot; for burst length 8. If you set this, you must also set the membl field in the ctrlcfg register.</description>
       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>useeccasdata</name>
       <description>This field allows the FPGA ports to directly access the extra data bits that are normally used to hold the ECC code. The interface width must be set to 24 or 40 in the dramifwidth register. If you set this, you must clear the eccen field in the ctrlcfg register.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>applycfg</name>
       <description>Write with this bit set to apply all the settings loaded in SDR registers to the memory interface. This bit is write-only and always returns 0 if read.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_ctrlwidth</name>
     <description>This register controls the width of the physical DRAM interface. </description>
     <addressOffset>0x5060</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffffc</resetMask>
     <fields>
      <field>
       <name>ctrlwidth</name>
       <description>Specifies controller DRAM interface width, with the following encoding. &amp;quot;00&amp;quot; for 8-bit, &amp;quot;01&amp;quot; for 16-bit (no ECC) or 24-bit (ECC enabled), &amp;quot;10&amp;quot; for 32-bit (no ECC) or 40-bit (ECC enabled). You must also program the dramifwidth register.</description>
       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_portcfg</name>
     <description>This register should be set to a zero in any bit which corresponds to a port which does mostly sequential memory accesses.  For ports with highly random accesses, the bit should be set to a one. </description>
     <addressOffset>0x507c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfff00000</resetMask>
     <fields>
      <field>
       <name>autopchen</name>
       <description>One bit per control port.  Set bit N to a 1 to have the controller request an automatic precharge following bus command completion (close the row automatically).  Set to a zero to request that the controller attempt to keep a row open.  For random dominated operations this register should be set to a 1 for all active ports.</description>
       <lsb>10</lsb>
       <msb>19</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_fpgaportrst</name>
     <description>This register implements functionality to allow the CPU to control when the MPFE will enable the ports to the FPGA fabric. </description>
     <addressOffset>0x5080</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffc000</resetMask>
     <fields>
      <field>
       <name>portrstn</name>
       <description>This register should be written to with a 1 to enable the selected FPGA port to exit reset.  Writing a bit to a zero will stretch the port reset until the register is written. Read data ports are connected to bits 3:0, with read data port 0 at bit 0 to read data port 3 at bit 3. Write data ports 0 to 3 are mapped to 4 to 7, with write data port 0 connected to bit 4 to write data port 3 at bit 7. Command ports are connected to bits 8 to 13, with command port 0 at bit 8 to command port 5 at bit 13. Expected usage would be to set all the bits at the same time but setting some bits to a zero and others to a one is supported.</description>
       <lsb>0</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_protportdefault</name>
     <description>This register controls the default protection assignment for a port.  Ports which have explicit rules which define regions which are illegal to access should set the bits to pass by default.  Ports which have explicit rules which define legal areas should set the bit to force all transactions to fail.  Leaving this register to all zeros should be used for systems which do not desire any protection from the memory controller. </description>
     <addressOffset>0x508c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffc00</resetMask>
     <fields>
      <field>
       <name>portdefault</name>
       <description>Determines the default action for a transactions from a port.  Set a bit to a zero to indicate that all accesses from the port should pass by default, set a bit to a one if the default protection is to fail the access.</description>
       <lsb>0</lsb>
       <msb>9</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_protruleaddr</name>
     <description>This register is used to control the memory protection for port 0 transactions.  Address ranges can either be used to allow access to memory regions or disallow access to memory regions.  If trustzone is being used, access can be enabled for protected transactions or disabled for unprotected transactions.  The default state of this register is to allow all access.  Address values used for protection are only physical addresses. </description>
     <addressOffset>0x5090</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xff000000</resetMask>
     <fields>
      <field>
       <name>lowaddr</name>
       <description>Lower 12 bits of the address for a check.  Address is compared to be less than or equal to the address of a transaction.  Note that since AXI transactions cannot cross a 4K byte boundary, the transaction start and transaction end address must also fall within the same 1MByte block pointed to by this address pointer.</description>
       <lsb>0</lsb>
       <msb>11</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>highaddr</name>
       <description>Upper 12 bits of the address for a check.  Address is compared to be greater than or equal to the address of a transaction.  Note that since AXI transactions cannot cross a 4K byte boundary, the transaction start and transaction end address must also fall within the same 1MByte block pointed to by this address pointer.</description>
       <lsb>12</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_protruleid</name>
     <description> </description>
     <addressOffset>0x5094</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xff000000</resetMask>
     <fields>
      <field>
       <name>lowid</name>
       <description>AxID for the protection rule.  Incoming AxID needs to be greater than or equal to this value.  For all AxIDs from a port, AxID high should be programmed to all ones.</description>
       <lsb>0</lsb>
       <msb>11</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>highid</name>
       <description>AxID for the protection rule.  Incoming AxID needs to be less than or equal to this value.  For all AxIDs from a port, AxID high should be programmed to all ones.</description>
       <lsb>12</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_protruledata</name>
     <description> </description>
     <addressOffset>0x5098</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffc000</resetMask>
     <fields>
      <field>
       <name>security</name>
       <description>A value of 2'b00 will make the rule apply to secure transactions.
A value of 2'b01 will make the rule apply to non-secure transactions.
A value of 2'b10 or 2'b11 will make the rule apply to secure and non-secure transactions.</description>
       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>validrule</name>
       <description>Set to bit to a one to make a rule valid, set to a zero to invalidate a rule.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>portmask</name>
       <description>Set  bit x to a one to have this rule apply to port x, set bit x to a zero to have the rule not apply to a port.&amp;#10;Note that port 0-port 5 are the FPGA fabric ports, port 6 is L3 read, port 7 is CPU read, port 8 is L3 write, port 9 is CPU write.</description>
       <lsb>3</lsb>
       <msb>12</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>ruleresult</name>
       <description>Set this bit to a one to force a protection failure, zero to allow the access the succeed</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_protrulerdwr</name>
     <description>This register is used to perform read and write operations to the internal protection table. </description>
     <addressOffset>0x509c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff80</resetMask>
     <fields>
      <field>
       <name>ruleoffset</name>
       <description>This field defines which of the 20 rules in the protection table you want to read or write.</description>
       <lsb>0</lsb>
       <msb>4</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>writerule</name>
       <description>Write to this bit to have the memory_prot_data register to the table at the offset specified by port_offset.  Bit automatically clears after a single cycle and the write operation is complete.</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>readrule</name>
       <description>Write to this bit to have the memory_prot_data register loaded with the value from the internal protection table at offset.  Table value will be loaded before a rdy is returned so read data from the register will be correct for any follow-on reads to the memory_prot_data register.</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_qoslowpri</name>
     <description>This register controls the mapping of AXI4 QOS received from the FPGA fabric to the internal priority used for traffic prioritization. </description>
     <addressOffset>0x50a0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfff00000</resetMask>
     <fields>
      <field>
       <name>lowpriorityval</name>
       <description>This 20 bit field is a 2 bit field for each of the 10 ports.  The field used for each port in this register controls the priority used for a port</description>
       <lsb>0</lsb>
       <msb>19</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_qoshighpri</name>
     <description> </description>
     <addressOffset>0x50a4</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfff00000</resetMask>
     <fields>
      <field>
       <name>highpriorityval</name>
       <description>This 20 bit field is a 2 bit field for each of the 10 ports.  The field used for each port in this register controls the priority used for a port</description>
       <lsb>0</lsb>
       <msb>19</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_qospriorityen</name>
     <description> </description>
     <addressOffset>0x50a8</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffc00</resetMask>
     <fields>
      <field>
       <name>priorityen</name>
       <description>This 10 bit field is set to a one to enable QOS usage for a port.</description>
       <lsb>0</lsb>
       <msb>9</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_mppriority</name>
     <description>This register is used to configure the DRAM burst operation scheduling. </description>
     <addressOffset>0x50ac</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xc0000000</resetMask>
     <fields>
      <field>
       <name>userpriority</name>
       <description>Set absolute user priority of the port.  Each port is represented by a 3 bit value, 000=lowest priority, 111=highest priority.  Port 0 is bits 2:0.  Port number offset corresponds to the control port assignment.</description>
       <lsb>0</lsb>
       <msb>29</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>ctrlgrp_mpweight_mpweight_0_4</name>
     <description>This register is used to configure the DRAM burst operation scheduling. </description>
     <addressOffset>0x50b0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <fields>
      <field>
