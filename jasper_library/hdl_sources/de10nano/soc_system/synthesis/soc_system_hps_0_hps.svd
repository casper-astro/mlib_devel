         </enumeratedValue>
         <enumeratedValue>
          <name>disabled</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ni</name>
       <description>Enable and Disable Normal Interrupt Summary</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>sdmmc_idinten_ni_enum</name>
