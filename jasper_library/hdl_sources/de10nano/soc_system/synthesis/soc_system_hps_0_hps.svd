       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spim_sr_tfnf_enum</name>
         <enumeratedValue>
          <name>full</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>notfull</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tfe</name>
       <description>Reports transmit FIFO condition.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spim_sr_tfe_enum</name>
         <enumeratedValue>
