          <value>4</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>trans64</name>
          <value>5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>trans128</name>
          <value>6</value>
         </enumeratedValue>
         <enumeratedValue>
