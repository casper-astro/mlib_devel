         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>gpio_ext_porta</name>
     <description>The external port register is used to input data to the metastability flops.</description>
     <addressOffset>0x50</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>gpio_ext_porta</name>
