    <register>
     <name>irqstat</name>
     <description>The status fields in this register are set when the described event occurs and the interrupt is enabled in the mask register. When any of these bit fields are set, the interrupt output is asserted high. The fields are each cleared by writing a 1 to the field. Note that bit fields 7 thru 11 are only valid when legacy SPI mode is active.</description>
     <addressOffset>0x40</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x100</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>underflowdet</name>
       <description>An underflow is detected when an attempt to transfer data is made when the transmit FIFO is empty. This may occur when the AHB write data is being supplied too slowly to keep up with the requested write operation. This bit is reset only by a system reset and cleared only when the register is read.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_underflowdet_enum</name>
         <enumeratedValue>
          <name>underflow</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nounderflow</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>indopdone</name>
       <description>Controller has completed last triggered indirect operation</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_indopdone_enum</name>
         <enumeratedValue>
          <name>indirectop</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noindirectop</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>indrdreject</name>
       <description>Indirect operation was requested but could not be accepted. Two indirect operations already in storage.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_indrdreject_enum</name>
         <enumeratedValue>
          <name>indirectreq</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noindirectreq</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>protwrattempt</name>
       <description>Write to protected area was attempted and rejected.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_protwrattempt_enum</name>
         <enumeratedValue>
          <name>writeprot</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nowriteprot</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>illegalacc</name>
       <description>Illegal AHB access has been detected. AHB wrapping bursts and the use of SPLIT/RETRY accesses will cause this error interrupt to trigger.</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_illegalacc_enum</name>
         <enumeratedValue>
          <name>illegalahb</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noillegalahb</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>indxfrlvl</name>
       <description>Indirect Transfer Watermark Level Reached</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_indxfrlvl_enum</name>
         <enumeratedValue>
          <name>waterlevl</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nowaterlvl</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rxover</name>
       <description>This should only occur in Legacy SPI mode. Set if an attempt is made to push the RX FIFO when it is full. This bit is reset only by a system reset and cleared only when this register is read. If a new push to the RX FIFO occurs coincident with a register read this flag will remain set. 0 : no overflow has been detected. 1 : an overflow has occurred.</description>
       <lsb>7</lsb>
       <msb>7</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_rxover_enum</name>
         <enumeratedValue>
          <name>rcvover</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>norcvover</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>txthreshcmp</name>
       <description>Indicates the number of entries in the transmit FIFO with respect to the threshold specified in the TXTHRESH register. Only relevant in SPI legacy mode.</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_txthreshcmp_enum</name>
         <enumeratedValue>
          <name>gt</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>le</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>txfull</name>
       <description>Indicates that the transmit FIFO is full or not. Only relevant in SPI legacy mode.</description>
       <lsb>9</lsb>
       <msb>9</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_txfull_enum</name>
         <enumeratedValue>
          <name>notfull</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>full</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rxthreshcmp</name>
       <description>Indicates the number of entries in the receive FIFO with respect to the threshold specified in the RXTHRESH register. Only relevant in SPI legacy mode.</description>
       <lsb>10</lsb>
       <msb>10</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_rxthreshcmp_enum</name>
         <enumeratedValue>
          <name>le</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>gt</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rxfull</name>
       <description>Indicates that the receive FIFO is full or not. Only relevant in SPI legacy mode.</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>qspiregs_irqstat_rxfull_enum</name>
         <enumeratedValue>
          <name>notfull</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>full</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>indsramfull</name>
       <description>Indirect Read Partition of SRAM is full and unable to immediately complete indirect operation</description>
       <lsb>12</lsb>
       <msb>12</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
