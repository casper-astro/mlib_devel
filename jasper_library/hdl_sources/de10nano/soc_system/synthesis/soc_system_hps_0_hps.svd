          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>epdisbldmsk</name>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_devgrp_diepmsk_epdisbldmsk_enum</name>
