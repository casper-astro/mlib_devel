          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>erlysusp</name>
       <description>Mode: Device only. The core sets this bit to indicate that an Idle state has been detected on the USB for 3 ms.</description>
       <lsb>10</lsb>
       <msb>10</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_globgrp_gintsts_erlysusp_enum</name>
         <enumeratedValue>
