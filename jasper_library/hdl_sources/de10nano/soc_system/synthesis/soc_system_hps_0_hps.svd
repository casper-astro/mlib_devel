          <name>enabled</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>thre_mode</name>
       <description>Programmable Transmitter Hold Register Empty interrupt</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>uart_cpr_thre_mode_enum</name>
         <enumeratedValue>
          <name>enabled</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>sir_mode</name>
       <description>Sir mode not used in this application.</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>uart_cpr_sir_mode_enum</name>
