          <value>2</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ptxqdepth</name>
       <description>Specifies the Host mode Periodic Request Queue depth.That is, the maximum number of packets that can reside in the Host Periodic TxFIFO. This queue holds one entry corresponding to each IN or OUT periodic request. This queue is 9 bits wide.</description>
       <lsb>24</lsb>
