      <field>
       <name>epdir</name>
       <description>Indicates whether the transaction is IN or OUT.</description>
       <lsb>15</lsb>
       <msb>15</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcchar2_epdir_enum</name>
         <enumeratedValue>
          <name>out</name>
