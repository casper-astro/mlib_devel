       <name>intkntxfempmsk</name>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_devgrp_diepmsk_intkntxfempmsk_enum</name>
         <enumeratedValue>
