          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>bblerr</name>
       <description>In Scatter/Gather DMA mode, the interrupt due to this bit is masked in the core..This bit can be set only by the core and the application should write 1 to clear it.</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcint15_bblerr_enum</name>
         <enumeratedValue>
