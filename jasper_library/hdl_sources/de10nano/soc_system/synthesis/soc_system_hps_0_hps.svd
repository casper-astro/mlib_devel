    <register>
     <name>nandgrp_bootstrap</name>
     <description>Bootstrap fields sampled by NAND Flash Controller when released from reset.
All fields are reset by a cold or warm reset.</description>
     <addressOffset>0x110</addressOffset>
     <size>32</size>
     <access>read-write</access>
