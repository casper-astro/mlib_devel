          <value>0x3</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>bootinfo</name>
     <description>Provides access to boot configuration information.</description>
     <addressOffset>0x14</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffe0000</resetMask>
     <fields>
      <field>
       <name>bsel</name>
       <description>The boot select field specifies the boot source. It is read by the Boot ROM code on a cold or warm reset to determine the boot source.

The HPS BSEL pins value are sampled upon deassertion of cold reset.</description>
       <lsb>0</lsb>
       <msb>2</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>sysmgr_bootinfo_bsel_BSEL_Enum</name>
         <enumeratedValue>
          <name>RESERVED</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>FPGA</name>
          <value>0x1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>NAND_Flash_1_8v</name>
          <value>0x2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>NAND_Flash_3_0v</name>
          <value>0x3</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>SD_MMC_EXTERNAL_TRANSCEIVER_1_8v</name>
          <value>0x4</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>SD_MMC_INTERNAL_TRANSCEIVER_3_0v</name>
          <value>0x5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>QSPI_Flash_1_8v</name>
          <value>0x6</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>QSPI_Flash_3_0v</name>
          <value>0x7</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>csel</name>
       <description>The clock select field specifies clock information for booting. The clock select encoding is a function of the CSEL value. The clock select field is read by the Boot ROM code on a cold or warm reset when booting from a flash device to get information about how to setup the HPS clocking to boot from the specified clock device.

The encoding of the clock select field is specified by the enum associated with this field.

The HPS CSEL pins value are sampled upon deassertion of cold reset.</description>
       <lsb>3</lsb>
       <msb>4</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>sysmgr_bootinfo_csel_enum</name>
         <enumeratedValue>
          <name>CSEL_0</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>CSEL_1</name>
          <value>0x1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>CSEL_2</name>
          <value>0x2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>CSEL_3</name>
          <value>0x3</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>pinbsel</name>
       <description>Specifies the sampled value of the HPS BSEL pins. The value of HPS BSEL pins are sampled upon deassertion of cold reset.</description>
       <lsb>5</lsb>
       <msb>7</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>pincsel</name>
       <description>Specifies the sampled value of the HPS CSEL pins. The value of HPS CSEL pins are sampled upon deassertion of cold reset.</description>
       <lsb>8</lsb>
       <msb>9</msb>
       <access>read-only</access>
      </field>
     </fields>
