     <fields>
      <field>
       <name>top</name>
       <description>This field is used to select the timeout period from which the watchdog counter restarts. A change of the timeout period takes effect only after the next counter restart (kick). The timeout period (in clocks) is:
t = 2**(16 + top)</description>
       <lsb>0</lsb>
       <msb>3</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>l4wd_wdt_torr_enum</name>
