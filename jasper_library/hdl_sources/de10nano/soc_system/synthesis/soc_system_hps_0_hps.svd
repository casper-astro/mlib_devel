         </enumeratedValue>
         <enumeratedValue>
          <name>send</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>wait_prvdata_complete</name>
       <description>Determines when command is sent. The send command at once option is typically used to query status of card during data transfer or to stop current data transfer.</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-write</access>
