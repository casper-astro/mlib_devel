          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>txe</name>
       <description>Data from the previous transmission is resent on the txd line. This bit is cleared when read.</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_sr_txe_enum</name>
         <enumeratedValue>
          <name>noerror</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>error</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
