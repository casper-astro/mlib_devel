         </enumeratedValue>
         <enumeratedValue>
          <name>end</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>begin</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>all</name>
          <value>3</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>compsplt</name>
       <description>The application sets this field to request the OTG host to perform a complete split transaction.</description>
       <lsb>16</lsb>
       <msb>16</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcsplt7_compsplt_enum</name>
