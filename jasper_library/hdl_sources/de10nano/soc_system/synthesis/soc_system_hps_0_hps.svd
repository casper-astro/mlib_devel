          <name>split</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>spltena</name>
       <description>The application sets this field to indicate that this channel is enabled to perform split transactions.</description>
       <lsb>31</lsb>
       <msb>31</msb>
       <access>read-write</access>
