    <register>
     <name>msghandgrp_MONDD</name>
     <description>New data bits for Message Objects 97 to 128.  By reading the NewDat bits, the CPU can check for which Message Object the data portion was updated. The NewDat bit of a specific Message Object can be set/reset by the CPU via the IFx Message Interface Registers or set by the Message Handler after reception of a Data Frame or reset by the Message Handler at start of a transmission. </description>
     <addressOffset>0xa8</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
