          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>stmeventintf</name>
       <description>Used to disable the STM event interface. This interface allows logic in the FPGA fabric to trigger events to the STM debug module in the HPS.</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
       <enumeratedValues>
