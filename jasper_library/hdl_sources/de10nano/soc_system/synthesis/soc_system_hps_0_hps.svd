          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rff</name>
       <description>Reports receive FIFO condition.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spim_sr_rff_enum</name>
         <enumeratedValue>
          <name>notfull</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
