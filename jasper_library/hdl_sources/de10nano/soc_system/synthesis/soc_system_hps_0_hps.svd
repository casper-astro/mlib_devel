      </field>
      <field>
       <name>ocram</name>
       <description>Resets On-chip RAM</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>sysmgr</name>
       <description>Resets logic in System Manager that doesn't differentiate between cold and warm resets</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>sysmgrcold</name>
       <description>Resets logic in System Manager that is only reset by a cold reset (ignores warm reset)</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>fpgamgr</name>
       <description>Resets FPGA Manager</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>acpidmap</name>
       <description>Resets ACP ID Mapper</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>s2f</name>
       <description>Resets logic in FPGA core that doesn't differentiate between HPS cold and warm resets (h2f_rst_n = 1)</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>s2fcold</name>
       <description>Resets logic in FPGA core that is only reset by a cold reset (ignores warm reset) (h2f_cold_rst_n = 1)</description>
       <lsb>7</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>nrstpin</name>
       <description>Pulls nRST pin low</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>timestampcold</name>
       <description>Resets debug timestamp to 0 (cold reset only)</description>
       <lsb>9</lsb>
       <msb>9</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>clkmgrcold</name>
       <description>Resets Clock Manager (cold reset only)</description>
       <lsb>10</lsb>
       <msb>10</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>scanmgr</name>
       <description>Resets Scan Manager</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>frzctrlcold</name>
       <description>Resets Freeze Controller in System Manager (cold reset only)</description>
       <lsb>12</lsb>
       <msb>12</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>sysdbg</name>
       <description>Resets logic that spans the system and debug domains.</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>dbg</name>
       <description>Resets logic located only in the debug domain.</description>
       <lsb>14</lsb>
       <msb>14</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>tapcold</name>
       <description>Resets portion of DAP JTAG TAP controller no reset by a debug probe reset (i.e. nTRST pin).  Cold reset only.</description>
       <lsb>15</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>sdrcold</name>
       <description>Resets logic in SDRAM Controller Subsystem affected only by a cold reset.</description>
       <lsb>16</lsb>
       <msb>16</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
   </registers>
