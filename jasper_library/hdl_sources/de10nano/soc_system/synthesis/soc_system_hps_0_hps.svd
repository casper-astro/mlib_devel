          <value>0x5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>degrees270</name>
          <value>0x6</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>degrees315</name>
          <value>0x7</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>fbclksel</name>
       <description>Select which fb_clk to be used as cclk_in_sample.
If 0, cclk_in_sample is driven by internal phase shifted cclk_in.
If 1, cclk_in_sample is driven by fb_clk_in. No phase shifting is provided internally on cclk_in_sample.
Note: Using the feedback clock (setting this bit to 1) is not a supported use model.</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
      </field>
     </fields>
