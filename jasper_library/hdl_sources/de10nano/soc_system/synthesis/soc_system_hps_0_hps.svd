  <peripheral>
   <name>l4wd1</name>
   <version>0.0</version>
   <description>Registers in the L4 Watchdog module</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_permodrst-&gt;l4wd1 == 1)</disableCondition><baseAddress>0xffd03000</baseAddress>
