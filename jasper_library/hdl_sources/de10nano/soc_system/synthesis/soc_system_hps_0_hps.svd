     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>addr</name>
       <description>This should be setup before triggering the command with execute field (bit 0) of the Flash Command Control register. It is the address used by the command specified in the opcode field (bits 31:24) of the Flash Command Control register.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
