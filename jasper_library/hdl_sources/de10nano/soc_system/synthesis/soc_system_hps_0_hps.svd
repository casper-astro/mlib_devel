          <name>endpt3</name>
          <value>3</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt4</name>
          <value>4</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt5</name>
          <value>5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt6</name>
