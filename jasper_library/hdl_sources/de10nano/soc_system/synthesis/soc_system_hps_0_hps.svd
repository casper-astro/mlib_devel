       <description>Message valid bits for Message Objects 97 to 128. Array index i corresponds to Message Object i+97.</description>
       <lsb>30</lsb>
       <msb>30</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>can_msghandgrp_MOVALD_MsgVal_enum</name>
         <enumeratedValue>
