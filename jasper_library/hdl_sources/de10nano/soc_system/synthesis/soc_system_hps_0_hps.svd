          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ahberrmsk</name>
       <description>In  scatter/gather DMA  mode  for  host, interrupts will not be generated due to the corresponding bits set in HCINTn.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk0_ahberrmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
