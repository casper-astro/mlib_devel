       <msb>3</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>clkmgr_perpllgrp_src_nand_enum</name>
         <enumeratedValue>
          <name>F2s_Periph_Ref_Clk</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Main_Nand_Clk</name>
          <value>0x1</value>
         </enumeratedValue>
         <enumeratedValue>
