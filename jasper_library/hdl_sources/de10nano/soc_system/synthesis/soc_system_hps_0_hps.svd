          <value>0x0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rfne</name>
       <description>Reports receive FIFO condition.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-only</access>
