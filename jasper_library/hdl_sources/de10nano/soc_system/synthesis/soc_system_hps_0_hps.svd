          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>intknepmismsk</name>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_devgrp_diepmsk_intknepmismsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>inepnakeffmsk</name>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_devgrp_diepmsk_inepnakeffmsk_enum</name>
         <enumeratedValue>
