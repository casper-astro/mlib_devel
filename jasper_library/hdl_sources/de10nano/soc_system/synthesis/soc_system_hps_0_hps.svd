         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rxfir</name>
       <description>The interrupt is active or inactive prior to masking.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_risr_rxfir_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0x0</value>
