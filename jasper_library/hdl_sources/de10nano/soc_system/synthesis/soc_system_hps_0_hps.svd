       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk0_chhltdmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
