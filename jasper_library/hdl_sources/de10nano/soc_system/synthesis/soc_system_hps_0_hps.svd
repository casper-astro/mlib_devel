  <peripheral>
   <name>acpidmap</name>
   <version>0.0</version>
   <description>Registers in the ACP ID Mapper module</description>
   <baseAddress>0xff707000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>vid2rd</name>
     <description>The Read AXI Master Mapping Register contains the USER, ADDR page, and ID signals mapping values for particular transaction with 12-bit ID which locks the fixed 3-bit virtual ID.</description>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x80040010</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>user</name>
       <description>This value is propagated to SCU as ARUSERS.</description>
       <lsb>4</lsb>
       <msb>8</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>page</name>
       <description>ARADDR remap to 1st, 2nd, 3rd, or 4th 1GB memory region.</description>
       <lsb>12</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
