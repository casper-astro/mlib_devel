       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>dma</name>
       <description>if set, DATA-DMA is present in hardware. </description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-only</access>
