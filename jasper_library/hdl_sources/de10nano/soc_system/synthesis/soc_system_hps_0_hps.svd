          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Cfg</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tristate</name>
       <description>Controls IO tri-state</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>sysmgr_frzctrl_ioctrl_tristate_enum</name>
         <enumeratedValue>
          <name>Enable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Cfg</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
