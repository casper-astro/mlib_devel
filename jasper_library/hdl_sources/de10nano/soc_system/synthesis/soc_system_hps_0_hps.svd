     <name>hostgrp_hcchar3</name>
     <description>Channel_number: 3.</description>
     <addressOffset>0x560</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>mps</name>
       <description>Indicates the maximum packet size of the associated endpoint.</description>
       <lsb>0</lsb>
       <msb>10</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>epnum</name>
       <description>Indicates the endpoint number on the device serving as the data source or sink.</description>
       <lsb>11</lsb>
       <msb>14</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcchar3_epnum_enum</name>
         <enumeratedValue>
          <name>endpt0</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt1</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt2</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt3</name>
          <value>3</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt4</name>
          <value>4</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt5</name>
          <value>5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt6</name>
          <value>6</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt7</name>
          <value>7</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt8</name>
          <value>8</value>
