          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>encmdaddr</name>
       <description>If enabled, the command specified in bits 31:24 requires an address. This should be setup before triggering the command via writing a 1 to the execute field.</description>
       <lsb>19</lsb>
       <msb>19</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_flashcmd_encmdaddr_enum</name>
         <enumeratedValue>
