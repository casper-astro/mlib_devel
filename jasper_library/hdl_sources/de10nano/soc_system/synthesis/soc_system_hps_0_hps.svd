          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>datatglerr</name>
       <description>This bit can be set only by the core and the application should write 1 to clear it. In Scatter/Gather DMA mode, the interrupt due to this bit is masked in the core.</description>
       <lsb>10</lsb>
       <msb>10</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcint1_datatglerr_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>bnaintr</name>
       <description>This bit is valid only when Scatter/Gather DMA mode is enabled. The core generates this interrupt when the descriptor accessed is not ready for the Core to process. BNA will not be generated for Isochronous channels. for non Scatter/Gather DMA mode, this bit is reserved.</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcint1_bnaintr_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>xcs_xact_err</name>
       <description>This bit is valid only when Scatter/Gather DMA mode is enabled. The core sets this bit when 3 consecutive transaction errors occurred on the USB bus. XCS_XACT_ERR will not be generated for Isochronous channels.for non Scatter/Gather DMA mode, this bit is reserved.</description>
       <lsb>12</lsb>
       <msb>12</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcint1_xcs_xact_err_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>acvtive</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>desc_lst_rollintr</name>
       <description>Descriptor rollover interrupt (DESC_LST_ROLLIntr)This bit is valid only when Scatter/Gather DMA mode is enabled. The core sets this bit when the corresponding channel's descriptor list rolls over. for non Scatter/Gather DMA mode, this bit is reserved.</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcint1_desc_lst_rollintr_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>hostgrp_hcintmsk1</name>
     <description>This register reflects the mask for each channel status described in the previous section.</description>
     <addressOffset>0x52c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>xfercomplmsk</name>
       <description>Transfer complete.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk1_xfercomplmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>chhltdmsk</name>
       <description>Channel Halted.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk1_chhltdmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ahberrmsk</name>
       <description>In  scatter/gather DMA  mode  for  host, interrupts will not be generated due to the corresponding bits set in HCINTn.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk1_ahberrmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>bnaintrmsk</name>
       <description>This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk1_bnaintrmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
