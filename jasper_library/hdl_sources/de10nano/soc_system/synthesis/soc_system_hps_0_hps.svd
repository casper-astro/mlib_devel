       <description>Set to the number of address bytes required (the address itself is programmed in the FLASH COMMAND ADDRESS REGISTERS). This should be setup before triggering the command via bit 0 of this register. 2'b00 : 1 address byte 2'b01 : 2 address bytes 2'b10 : 3 address bytes 2'b11 : 4 address bytes</description>
       <lsb>16</lsb>
       <msb>17</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_flashcmd_numaddrbytes_enum</name>
         <enumeratedValue>
          <name>addrbyte1</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>addrbyte2</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>addrbyte3</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>addrbyte4</name>
          <value>3</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>enmodebit</name>
       <description>Set to 1 to ensure the mode bits as defined in the Mode Bit Configuration register are sent following the address bytes.</description>
       <lsb>18</lsb>
       <msb>18</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_flashcmd_enmodebit_enum</name>
         <enumeratedValue>
