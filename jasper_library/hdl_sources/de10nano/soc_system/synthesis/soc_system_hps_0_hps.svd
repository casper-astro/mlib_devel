         </enumeratedValue>
         <enumeratedValue>
          <name>rdpartnotfull</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>irqmask</name>
     <description>If disabled, the interrupt for the corresponding interrupt status register bit is disabled. If enabled, the interrupt for the corresponding interrupt status register bit is enabled.</description>
     <addressOffset>0x44</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>underflowdet</name>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_irqmask_underflowdet_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
