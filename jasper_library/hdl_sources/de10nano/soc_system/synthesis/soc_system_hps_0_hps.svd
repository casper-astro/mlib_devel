  </peripheral>
  <peripheral>
   <name>qspiregs</name>
   <version>0.0</version>
   <description>Registers in the QSPI Flash Controller module accessible via its APB slave</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_permodrst-&gt;qspi == 1)</disableCondition><baseAddress>0xff705000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0x100</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>cfg</name>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x780000</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>en</name>
       <description>If this bit is disabled, the QSPI will finish the current transfer of the data word (FF_W) and stop sending. When Enabled, and qspi_n_mo_en = 0, all output enables are inactive and all pins are set to input mode.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_en_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>selclkpol</name>
       <description>Controls spiclk modes of operation.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_selclkpol_enum</name>
         <enumeratedValue>
          <name>low</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>high</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>selclkphase</name>
       <description>Selects whether the clock is in an active or inactive phase outside the SPI word.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_selclkphase_enum</name>
         <enumeratedValue>
          <name>active</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>inactive</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>endiracc</name>
       <description>If disabled, the Direct Access Controller becomes inactive once the current transfer of the data word (FF_W) is complete. When the Direct Access Controller and Indirect Access Controller are both disabled, all AHB requests are completed with an error response.</description>
       <lsb>7</lsb>
       <msb>7</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_endiracc_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>enlegacyip</name>
       <description>This bit can select the Direct Access Controller/Indirect Access Controller or legacy mode.If legacy mode is selected, any write to the controller via the AHB interface is serialized and sent to the FLASH device. Any valid AHB read will pop the internal RX-FIFO, retrieving data that was forwarded by the external FLASH device on the SPI lines, byte transfers of 4, 2 or 1 are permitted and controlled via the HSIZE input.</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_enlegacyip_enum</name>
         <enumeratedValue>
          <name>legmode</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>dimode</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>perseldec</name>
       <description>Select between '1 of 4 selects' or 'external 4-to-16 decode'. The qspi_n_ss_out[3:0] output signals are controlled.</description>
       <lsb>9</lsb>
       <msb>9</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_perseldec_enum</name>
         <enumeratedValue>
          <name>sel4to16</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>sel1of4</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>percslines</name>
       <description>Peripheral chip select line output decode type. As per perseldec, if perseldec = 0, the decode is select 1 of 4 decoding on signals, qspi_n_ss_out[3:0], The asserted decode line goes to 0. If perseldec = 1, the signals qspi_n_ss_out[3:0] require an external 4 to 16 decoder.</description>
       <lsb>10</lsb>
       <msb>13</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>wp</name>
       <description>This bit controls the write protect pin of the flash devices. The signal qspi_mo2_wpn needs to be resynchronized to the generated memory clock as necessary.</description>
       <lsb>14</lsb>
       <msb>14</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_wp_enum</name>
         <enumeratedValue>
          <name>wrproton</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>wrtprotoff</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>endma</name>
       <description>Allows DMA handshaking mode. When enabled the QSPI will trigger DMA transfer requests via the DMA peripheral interface.</description>
       <lsb>15</lsb>
       <msb>15</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_endma_enum</name>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>enahbremap</name>
       <description>(Direct Access Mode Only) When enabled, the incoming AHB address will be adapted and sent to the FLASH device as (address + N), where N is the value stored in the remap address register.</description>
       <lsb>16</lsb>
       <msb>16</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_enahbremap_enum</name>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>enterxipnextrd</name>
       <description>If XIP is enabled, then setting to disabled will cause the controller to exit XIP mode on the next READ instruction. If XIP is disabled, then setting to enabled will inform the controller that the device is ready to enter XIP on the next READ instruction. The controller will therefore send the appropriate command sequence, including mode bits to cause the device to enter XIP mode. Use this register after the controller has ensured the FLASH device has been configured to be ready to enter XIP mode. Note : To exit XIP mode, this bit should be set to 0. This will take effect in the attached device only AFTER the next READ instruction is executed. Software should therefore ensure that at least one READ instruction is requested after resetting this bit before it can be sure XIP mode in the device is exited.</description>
       <lsb>17</lsb>
       <msb>17</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_enterxipnextrd_enum</name>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>enterxipimm</name>
       <description>If XIP is enabled, then setting to disabled will cause the controller to exit XIP mode on the next READ instruction. If XIP is disabled, then setting enable will operate the device in XIP mode immediately. Use this register when the external device wakes up in XIP mode (as per the contents of its non- volatile configuration register). The controller will assume the next READ instruction will be passed to the device as an XIP instruction, and therefore will not require the READ opcode to be transferred. Note: To exit XIP mode, this bit should be set to 0. This will take effect in the attached device only after the next READ instruction is executed. Software therefore should ensure that at least one READ instruction is requested after resetting this bit in order to be sure that XIP mode is exited.</description>
       <lsb>18</lsb>
       <msb>18</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_enterxipimm_enum</name>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>bauddiv</name>
       <description>SPI baud rate = ref_clk / (2 * baud_rate_divisor)</description>
       <lsb>19</lsb>
       <msb>22</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_cfg_bauddiv_enum</name>
         <enumeratedValue>
          <name>baud2</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud4</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud6</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud8</name>
          <value>3</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud10</name>
          <value>4</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud12</name>
          <value>5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud14</name>
          <value>6</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud16</name>
          <value>7</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud18</name>
          <value>8</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud20</name>
          <value>9</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud22</name>
          <value>10</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud24</name>
          <value>11</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud26</name>
          <value>12</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud28</name>
          <value>13</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud30</name>
          <value>14</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>baud32</name>
          <value>15</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>idle</name>
       <description>This is a STATUS read-only bit. Note this is a retimed signal, so there will be some inherent delay on the generation of this status signal.</description>
       <lsb>31</lsb>
       <msb>31</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>qspiregs_cfg_idle_enum</name>
         <enumeratedValue>
          <name>set</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>notset</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>devrd</name>
     <addressOffset>0x4</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x3</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rdopcode</name>
       <description>Read Opcode to use when not in XIP mode</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_devrd_rdopcode_enum</name>
         <enumeratedValue>
          <name>read</name>
          <value>3</value>
         </enumeratedValue>
