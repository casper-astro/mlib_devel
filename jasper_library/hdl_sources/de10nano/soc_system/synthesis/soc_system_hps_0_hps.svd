    <register>
     <name>data</name>
     <description>Provides read/write access to data FIFO. Addresses 0x200 and above are mapped to the data FIFO. More than one address is mapped to data FIFO so that FIFO can be accessed using bursts.</description>
     <addressOffset>0x200</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <fields>
      <field>
       <name>value</name>
       <description>Provides read/write access to data FIFO.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
