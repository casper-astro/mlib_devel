    <register>
     <name>param_features</name>
     <description>Shows Available hardware features or attributes</description>
     <addressOffset>0x3f0</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x841</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>n_banks</name>
