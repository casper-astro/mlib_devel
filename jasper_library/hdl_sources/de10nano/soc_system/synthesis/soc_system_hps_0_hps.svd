         <enumeratedValue>
          <name>NoChange</name>
          <value>0x7</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>TxOK</name>
       <description>Transmitted a Message Successfully</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-only</access>
       <enumeratedValues>
