         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>numrddatabytes</name>
       <description>Up to 8 data bytes may be read using this command. Set to 0 for 1 byte and 7 for 8 bytes.</description>
       <lsb>20</lsb>
       <msb>22</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>qspiregs_flashcmd_numrddatabytes_enum</name>
         <enumeratedValue>
          <name>rdbyte1</name>
