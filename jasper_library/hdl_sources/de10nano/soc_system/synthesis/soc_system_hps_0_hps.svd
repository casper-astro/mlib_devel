    <register>
     <name>wddbg</name>
     <description>Controls the behavior of the L4 watchdogs when the CPUs are in debug mode. These control registers are used to drive the pause input signal of the L4 watchdogs. Note that the watchdogs built into the MPU automatically are paused when their associated CPU enters debug mode. Only reset by a cold reset.</description>
     <addressOffset>0x10</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0xf</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>mode_0</name>
       <description>Controls behavior of L4 watchdog when CPUs in debug mode. Field array index matches L4 watchdog index.</description>
       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>sysmgr_wddbg_mode_enum</name>
         <enumeratedValue>
          <name>Continue</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>PauseCPU0</name>
          <value>0x1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>PauseCPU1</name>
          <value>0x2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>PauseEither</name>
          <value>0x3</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>mode_1</name>
       <description>Controls behavior of L4 watchdog when CPUs in debug mode. Field array index matches L4 watchdog index.</description>
       <lsb>2</lsb>
       <msb>3</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>sysmgr_wddbg_mode_enum</name>
         <enumeratedValue>
          <name>Continue</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>PauseCPU0</name>
          <value>0x1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>PauseCPU1</name>
          <value>0x2</value>
         </enumeratedValue>
         <enumeratedValue>
