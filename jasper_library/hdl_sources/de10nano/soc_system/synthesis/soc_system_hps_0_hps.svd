          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>bnaintrmsk</name>
       <description>This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk5_bnaintrmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>frm_lst_rollintrmsk</name>
       <description>This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk5_frm_lst_rollintrmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
