    </register>
    <register>
     <name>msghandgrp_MOIPA</name>
     <description>Interrupt pending bits for Message Objects 1 to 32.  By reading the IntPnd bits, the CPU can check for which Message Object an interrupt is pending. The IntPnd bit of a specific Message Object can be set/reset by the CPU via the IFx Message Interface Registers or set by the Message Handler after reception or after a successful transmission of a frame. This will also affect the valid of IntID in the Interrupt Register. </description>
     <addressOffset>0xb0</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
