    <register>
     <name>idsts</name>
     <description>Sets Internal DMAC Status Fields</description>
     <addressOffset>0x8c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>ti</name>
       <description>Indicates that data transmission is finished for a descriptor.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_ti_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ri</name>
       <description>Indicates the completion of data reception for a descriptor</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_ri_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>fbe</name>
       <description>Indicates that a Bus Error occurred (IDSTS[12:10]). When setthe DMA disables all its bus accesses.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_fbe_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>du</name>
       <description>This status bit is set when the descriptor is unavailable due to OWN bit = 0 (DES0[31] =0).</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_du_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ces</name>
       <description>Indicates the status of the transaction to/from the card; also present in RINTSTS. Indicates the logical OR of the following bits:
EBE - End Bit Error
RTO - Response Timeout/Boot Ack Timeout
RCRC - Response CRC
SBE - Start Bit Error
DRTO - Data Read Timeout/BDS timeout
DCRC - Data CRC for Receive
RE - Response Error</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_ces_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>nis</name>
       <description>Logical OR of the following:
IDSTS[0] - Transmit Interrupt
IDSTS[1] - Receive Interrupt
Only unmasked bits affect this bit. This is a sticky bit and must be cleared each time a corresponding bit that causes NIS to be set is cleared.</description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_nis_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ais</name>
       <description>Logical OR of the following:
IDSTS[2] - Fatal Bus Interrupt
IDSTS[4] - DU bit Interrupt
IDSTS[5] - Card Error Summary Interrupt
Only unmasked bits affect this bit. This is a sticky bit and must be cleared each time a corresponding bit that causes AIS to be set is cleared.</description>
       <lsb>9</lsb>
       <msb>9</msb>
       <access>read-write</access>
       <modifiedWriteValues>oneToClear</modifiedWriteValues>
       <enumeratedValues>
        <name>sdmmc_idsts_ais_enum</name>
         <enumeratedValue>
          <name>clr</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>noclr</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>eb</name>
       <description>Indicates the type of error that caused a Bus Error. Valid only with Fatal Bus Error bit (IDSTS[2]) set. This field does not generate an interrupt.</description>
       <lsb>10</lsb>
       <msb>12</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>sdmmc_idsts_eb_enum</name>
         <enumeratedValue>
          <name>hostarbttx</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>hostarbrx</name>
          <value>2</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>fsm</name>
       <description>DMAC FSM present state.</description>
       <lsb>13</lsb>
       <msb>16</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>sdmmc_idsts_fsm_enum</name>
         <enumeratedValue>
          <name>dmaidle</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
