          <name>Use</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>IntPnd</name>
       <description>Interrupt Pending</description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>can_msgifgrp_IF1MCTR_IntPnd_enum</name>
         <enumeratedValue>
          <name>NotSrc</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Src</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>MsgLst</name>
       <description>Message Lost</description>
       <lsb>14</lsb>
       <msb>14</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>can_msgifgrp_IF1MCTR_MsgLst_enum</name>
         <enumeratedValue>
          <name>NotLost</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Lost</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>NewDat</name>
       <description>New Data</description>
       <lsb>15</lsb>
       <msb>15</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>can_msgifgrp_IF1MCTR_NewDat_enum</name>
         <enumeratedValue>
          <name>NotWritten</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
