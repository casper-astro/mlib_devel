         </enumeratedValue>
         <enumeratedValue>
          <name>Reserved_1</name>
          <value>5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Reserved_2</name>
          <value>6</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>Reserved_3</name>
          <value>7</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>perpllgrp_gpiodiv</name>
     <description>Contains a field that controls the clock divider for the GPIO De-bounce clock.

Only reset by a cold reset.</description>
     <addressOffset>0xa8</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x1</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>gpiodbclk</name>
       <description>The gpio_db_clk is divided down from the periph_base_clk by the value plus one specified in this field. The value 0 (divide by 1) is illegal. A value of 1 indicates divide by 2, 2 divide by 3, etc.</description>
       <lsb>0</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>perpllgrp_src</name>
     <description>Contains fields that select the source clocks for the flash controllers.

Fields are only reset by a cold reset.</description>
     <addressOffset>0xac</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x15</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>sdmmc</name>
       <description>Selects the source clock for the SDMMC.

Qsys and user documenation refer to f2s_periph_ref_clk as f2h_periph_ref_clk.</description>
       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>clkmgr_perpllgrp_src_sdmmc_enum</name>
         <enumeratedValue>
