          <name>Enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>traceintf</name>
       <description>Used to disable the trace interface. This interface allows the HPS debug logic to send trace data to logic in the FPGA fabric.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-write</access>
       <enumeratedValues>
