       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcintmsk2_xfercomplmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>chhltdmsk</name>
