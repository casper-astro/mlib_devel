    <register>
     <name>msghandgrp_MOVALB</name>
     <description>Message valid bits for Message Objects 33 to 64.  By reading the MsgVal bits, the CPU can check for which Message Object is valid. The MsgVal bit of a specific Message Object can be set/reset by the CPU via the IFx Message Interface Registers. </description>
     <addressOffset>0xc8</addressOffset>
