          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>back2backsetup</name>
       <description>Applies to Control OUT endpoints only. This bit indicates that the core has received more than three back-to-back SETUP packets for this particular endpoint. for information about handling this interrupt,</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>usb_devgrp_doepint7_back2backsetup_enum</name>
