      </field>
      <field>
       <name>ahberrmsk</name>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_devgrp_diepmsk_ahberrmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>nomask</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>timeoutmsk</name>
       <description>Non-isochronous endpoints</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_devgrp_diepmsk_timeoutmsk_enum</name>
         <enumeratedValue>
          <name>mask</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
