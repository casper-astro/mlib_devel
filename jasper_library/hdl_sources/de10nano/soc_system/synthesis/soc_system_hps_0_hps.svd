      <field>
       <name>txoicr</name>
       <description>This register reflects the status of the interrupt. A read from this register clears the ssi_txo_intr interrupt; writing has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rxoicr</name>
     <addressOffset>0x3c</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rxoicr</name>
       <description>This register reflects the status of the interrupt. A read from this register clears the ssi_rxo_intr interrupt; writing has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rxuicr</name>
     <addressOffset>0x40</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rxuicr</name>
       <description>This register reflects the status of the interrupt. A read from this register clears the ssi_rxu_intr interrupt; writing has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>icr</name>
     <addressOffset>0x48</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>icr</name>
       <description>This register is set if any of the interrupts below are active. A read clears the ssi_txo_intr, ssi_rxu_intr, ssi_rxo_intr, and the ssi_mst_intr interrupts. Writing to this register has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>dmacr</name>
     <description>The register is used to enable the DMA Controller interface operation.</description>
     <addressOffset>0x4c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rdmae</name>
       <description>This bit enables/disables the receive FIFO DMA channel
</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_dmacr_rdmae_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tdmae</name>
       <description>This bit enables/disables the transmit FIFO DMA channel.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_dmacr_tdmae_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>dmatdlr</name>
     <description>Controls DMA Transmit FIFO Threshold</description>
     <addressOffset>0x50</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dmatdl</name>
       <description>This bit field controls the level at which a DMA request is made by the transmit logic. It is equal to the watermark level; that is, the dma_tx_req signal is generated when the number of valid data entries in the transmit FIFO is equal to or below this field value, and TDMAE = 1.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>dmardlr</name>
     <description>Controls DMA Receive FIFO Threshold</description>
     <addressOffset>0x54</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dmardl</name>
       <description>This bit field controls the level at which a DMA request is made by the receive logic. The watermark level = DMARDL+1; that is, dma_rx_req is generated when the number of valid data entries in the receive FIFO is equal to or above this field value + 1, and RDMAE=1.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>idr</name>
     <description>This register stores a peripheral identification code</description>
     <addressOffset>0x58</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x5510005</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>idr</name>
       <description>This filed contains the peripherals identification code, 0x05510005.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>spi_version_id</name>
     <description>This read-only register stores the specific SPI Slave component version.</description>
     <addressOffset>0x5c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x3332302a</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>spi_version_id</name>
       <description>Contains the hex representation of the Synopsys component version. Consists of ASCII value for each number in the version.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>dr</name>
     <description>The data register is a 16-bit read/write buffer for the transmit/receive FIFOs. When the register is read, data in the receive FIFO buffer is accessed. When it is written to, data are moved into the transmit FIFO buffer; a write can occur only when SPI_EN = 1. FIFOs are reset when SPI_EN = 0.</description>
     <addressOffset>0x60</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dr</name>
       <description>When writing to this register, you must right-justify the data. Read data are automatically right-justified.
Read = Receive FIFO buffer
Write = Transmit FIFO buffer</description>
       <lsb>0</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
   </registers>
  </peripheral>
  <peripheral>
   <name>spis1</name>
   <version>0.0</version>
   <description>Registers in the SPI Slave module</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_permodrst-&gt;spis1 == 1)</disableCondition><baseAddress>0xffe03000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0x64</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>ctrlr0</name>
     <description>This register controls the serial data transfer. It is impossible to write to this register when the SPI Slave is enabled. The SPI Slave is enabled and disabled by writing to the SPIENR register.</description>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x7</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dfs</name>
       <description>Selects the data frame length. When the data frame size is programmed to be less than 16 bits, the receive data are automatically right-justified by the receive logic, with the upper bits of the receiver FIFO zero-padded. You must right-justify transmit data before writing into the transmit FIFO. The transmit logic ignores the upper unused bits when transmitting the data.</description>
       <lsb>0</lsb>
       <msb>3</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_dfs_enum</name>
         <enumeratedValue>
          <name>width4bit</name>
          <value>3</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>width5bit</name>
          <value>4</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>width6bit</name>
          <value>5</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>width7bit</name>
          <value>6</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>width8bit</name>
          <value>7</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>width9bit</name>
          <value>8</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>width10bit</name>
          <value>9</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>frf</name>
       <description>Selects which serial protocol transfers the data.</description>
       <lsb>4</lsb>
       <msb>5</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_frf_enum</name>
         <enumeratedValue>
          <name>motspi</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>tissp</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>natmw</name>
          <value>2</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>scph</name>
       <description>Valid when the frame format (FRF) is set to Motorola SPI. The serial clock phase selects the relationship of the serial clock with the slave select signal. When SCPH = 0, data are captured on the first edge of the serial clock. When SCPH = 1, the serial clock starts toggling one cycle after the slave select line is activated, and data are captured on the second edge of the serial clock.</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_scph_enum</name>
         <enumeratedValue>
          <name>inactivelow</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>inactivehigh</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>scpol</name>
       <description>Valid when the frame format (FRF) is set to Motorola SPI. Used to select the polarity of the inactive serial clock, which is held inactive when the spi master is not actively transferring data on the serial bus.</description>
       <lsb>7</lsb>
       <msb>7</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_scpol_enum</name>
         <enumeratedValue>
          <name>midbit</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>startbit</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tmod</name>
       <description>Selects the mode of transfer for serial communication. This field does not affect the transfer duplicity. Only indicates whether the receive or transmit data are valid. In transmit-only mode, data received from the external device is not valid and is not stored in the receive FIFO memory; it is overwritten on the next transfer. In receive-only mode, transmitted data are not valid. After the first write to the transmit FIFO, the same word is retransmitted for the duration of the transfer. In transmit-and-receive mode, both transmit and receive data are valid. The transfer continues until the transmit FIFO is empty. Data received from the external device are stored into the receive FIFO memory</description>
       <lsb>8</lsb>
       <msb>9</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_tmod_enum</name>
         <enumeratedValue>
          <name>txrx</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>txonly</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>rxonly</name>
          <value>2</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>slv_oe</name>
       <description>This bit enables or disables the setting of the spis0_ssi_oe_n output from the SPI Slave. When SLV_OE = 1, the spis0_ssi_oe_n output can never be active. When the spis0_ssi_oe_n output controls the tri-state buffer on the txd output from the slave, a high impedance state is always present on the slave spis0_txd output when SLV_OE = 1. This is useful when the master transmits in broadcast mode (master transmits data to all slave devices). Only one slave may respond with data on the master spis0_rxd line. This bit is enabled after reset and must be disabled by software (when broadcast mode is used), if you do not want this device to respond with data.</description>
       <lsb>10</lsb>
       <msb>10</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_slv_oe_enum</name>
         <enumeratedValue>
          <name>enabled</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>disabled</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>srl</name>
       <description>Used for testing purposes only. When internally active, connects the transmit shift register output to the receive shift register input.</description>
       <lsb>11</lsb>
       <msb>11</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_ctrlr0_srl_enum</name>
         <enumeratedValue>
          <name>normmode</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>testmode</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>cfs</name>
       <description>Selects the length of the control word for the Microwire frame format. The length (in bits) is the value of this field plus 1.</description>
       <lsb>12</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>spienr</name>
     <description>Enables and disables all SPI operations.</description>
     <addressOffset>0x8</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>spi_en</name>
       <description>When disabled, all serial transfers are halted immediately. Transmit and receive FIFO buffers are cleared when the device is disabled. It is impossible to program some of the SPI Slave control registers when enabled.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_spienr_spi_en_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>mwcr</name>
     <description>This register controls the direction of the data word for the half-duplex Microwire serial protocol. It is impossible to write to this register when the SPI Slave is enabled. The SPI Slave is enabled and disabled by writing to the SPIENR register.</description>
     <addressOffset>0xc</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>mwmod</name>
       <description>Defines whether the Microwire transfer is sequential or non-sequential. When sequential mode is used, only one control word is needed to transmit or receive a block of data words. When non-sequential mode is used, there must be a control word for each data word that is transmitted or received.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_mwcr_mwmod_enum</name>
         <enumeratedValue>
          <name>nonseq</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>seq</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>mdd</name>
       <description>Defines the direction of the data word when the Microwire serial protocol is used.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spis_mwcr_mdd_enum</name>
         <enumeratedValue>
          <name>rxmode</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>txmode</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>txftlr</name>
     <description>This register controls the threshold value for the transmit FIFO memory. It is impossible to write to this register when the SPI Slave is enabled. The SPI Slave is enabled and disabled by writing to the SPIENR register.</description>
     <addressOffset>0x18</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>tft</name>
       <description>Controls the level of entries (or below) at which the transmit FIFO controller triggers an interrupt. When the number of transmit FIFO entries is less than or equal to this value, the transmit FIFO empty interrupt is triggered.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rxftlr</name>
     <description>This register controls the threshold value for the receive FIFO memory. It is impossible to write to this register when the SPI Slave is enabled. The SPI Slave is enabled and disabled by writing to the SPIENR register.</description>
     <addressOffset>0x1c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rft</name>
       <description>Controls the level of entries (or above) at which the receive FIFO controller triggers an interrupt. When the number of receive FIFO entries is greater than or equal to this value + 1, the receive FIFO full interrupt is triggered.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>txflr</name>
     <description>This register contains the number of valid data entries in the transmit FIFO memory. Ranges from 0 to 256.</description>
     <addressOffset>0x20</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>txtfl</name>
       <description>Contains the number of valid data entries in the transmit FIFO.</description>
       <lsb>0</lsb>
       <msb>8</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rxflr</name>
     <description>This register contains the number of valid data entriesin the receive FIFO memory. This register can be read at any time. Ranges from 0 to 256.</description>
     <addressOffset>0x24</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rxtfl</name>
       <description>Contains the number of valid data entries in the receive FIFO.</description>
       <lsb>0</lsb>
       <msb>8</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>sr</name>
     <description>Reports FIFO transfer status, and any transmission/reception errors that may have occurred. The status register may be read at any time. None of the bits in this register request an interrupt.</description>
     <addressOffset>0x28</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x6</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>busy</name>
       <description>Reports the status of a serial transfer</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_sr_busy_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tfnf</name>
       <description>Reports the status of the transmit FIFO.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_sr_tfnf_enum</name>
         <enumeratedValue>
          <name>full</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>notfull</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tfe</name>
       <description>Reports the status of transmit FIFO empty. This bit field does not request an interrupt.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_sr_tfe_enum</name>
         <enumeratedValue>
          <name>empty</name>
          <value>0x1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>notempty</name>
          <value>0x0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rfne</name>
       <description>Reports the status of receive FIFO empty.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_sr_rfne_enum</name>
         <enumeratedValue>
          <name>empty</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>notempty</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rff</name>
       <description>Reports the status of receive FIFO Full</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_sr_rff_enum</name>
         <enumeratedValue>
          <name>notfull</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>full</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>txe</name>
       <description>Data from the previous transmission is resent on the txd line. This bit is cleared when read.</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-only</access>
       <enumeratedValues>
