       </enumeratedValues>
      </field>
      <field>
       <name>rxuir</name>
       <description>The interrupt is active or inactive prior to masking.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spim_risr_rxuir_enum</name>
         <enumeratedValue>
          <name>inactive</name>
