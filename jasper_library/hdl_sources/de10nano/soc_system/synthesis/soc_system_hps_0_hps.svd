         <enumeratedValue>
          <name>Extended</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>MsgVal</name>
       <description> The CPU must reset the MsgVal bit of all unused Messages Objects during the initialization before it resets bit Init in the CAN Control Register. MsgVal must also be reset if the Messages Object is no longer used in operation. For reconfiguration of Message Objects during normal operation. </description>
       <lsb>31</lsb>
       <msb>31</msb>
       <access>read-write</access>
