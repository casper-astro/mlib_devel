       <name>cp_wdt_hc_rmod</name>
       <description>Specifies if response mode (when counter reaches 0) is programmable or hardcoded.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>l4wd_wdt_comp_param_1_cp_wdt_hc_rmod_enum</name>
         <enumeratedValue>
          <name>programmable</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>cp_wdt_hc_rpl</name>
       <description>Specifies if the reset pulse length is programmable or hardcoded.</description>
       <lsb>4</lsb>
       <msb>4</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>l4wd_wdt_comp_param_1_cp_wdt_hc_rpl_enum</name>
         <enumeratedValue>
          <name>hardcoded</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>cp_wdt_hc_top</name>
       <description>Specifies if the timeout period is programmable or hardcoded.</description>
       <lsb>5</lsb>
       <msb>5</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>l4wd_wdt_comp_param_1_cp_wdt_hc_top_enum</name>
         <enumeratedValue>
          <name>programmable</name>
          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>cp_wdt_use_fix_top</name>
       <description>Specifies if the watchdog uses the pre-defined timeout values or if these were overriden with customer values when the watchdog was configured.</description>
       <lsb>6</lsb>
       <msb>6</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>l4wd_wdt_comp_param_1_cp_wdt_use_fix_top_enum</name>
         <enumeratedValue>
          <name>predefined</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>cp_wdt_pause</name>
       <description>Should specify if the pause input is included or not. However, this field is always hardwired to 0 so you can't figure this out by reading this field. The pause input is included and can be used to pause the watchdog when the MPU is in debug mode.</description>
       <lsb>7</lsb>
       <msb>7</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>cp_wdt_apb_data_width</name>
       <description>APB Bus Width</description>
       <lsb>8</lsb>
       <msb>9</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>l4wd_wdt_comp_param_1_cp_wdt_apb_data_width_enum</name>
         <enumeratedValue>
          <name>width32bits</name>
          <value>2</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>cp_wdt_dflt_rpl</name>
