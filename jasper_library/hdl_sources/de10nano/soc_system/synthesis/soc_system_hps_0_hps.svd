     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>txeir</name>
       <description>The interrupt is active or inactive prior to masking.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_risr_txeir_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>txoir</name>
       <description>The interrupt is active or inactive prior to masking.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_risr_txoir_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rxuir</name>
       <description>The interrupt is active or inactive prior to masking.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_risr_rxuir_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rxoir</name>
       <description>The interrupt is active or inactive prior to masking.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>spis_risr_rxoir_enum</name>
         <enumeratedValue>
          <name>inactive</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
