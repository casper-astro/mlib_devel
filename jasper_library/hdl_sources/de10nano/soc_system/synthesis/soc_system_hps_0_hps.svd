       <access>read-write</access>
      </field>
      <field>
       <name>sdmmc</name>
       <description>Resets SD/MMC controller</description>
       <lsb>22</lsb>
       <msb>22</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>can0</name>
       <description>Resets CAN0 controller.

Writes to this field on devices not containing CAN controllers will be ignored.</description>
       <lsb>23</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>can1</name>
       <description>Resets CAN1 controller.

Writes to this field on devices not containing CAN controllers will be ignored.</description>
       <lsb>24</lsb>
       <msb>24</msb>
       <access>read-write</access>
      </field>
      <field>
       <name>gpio0</name>
       <description>Resets GPIO0</description>
       <lsb>25</lsb>
