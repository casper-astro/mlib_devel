       </enumeratedValues>
      </field>
      <field>
       <name>ai</name>
       <description>This bit enables the following bits:
IDINTEN[2] - Fatal Bus Error Interrupt
IDINTEN[4] - DU Interrupt
IDINTEN[5] - Card Error Summary Interrupt</description>
       <lsb>9</lsb>
       <msb>9</msb>
       <access>read-write</access>
