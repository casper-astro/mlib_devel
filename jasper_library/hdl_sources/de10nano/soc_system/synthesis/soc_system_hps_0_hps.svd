       <msb>12</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>lba</name>
       <description>if set, hardware supports Toshiba LBA devices. </description>
       <lsb>13</lsb>
       <msb>13</msb>
       <access>read-only</access>
      </field>
     </fields>
