   <registers>
    <register>
     <name>wdt_cr</name>
     <description>Contains fields that control operating functions.</description>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x2</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>wdt_en</name>
       <description>This bit is used to enable and disable the watchdog. When disabled, the counter does not decrement. Thus, no interrupts or warm reset requests are generated. Once this bit has been enabled, it can only be cleared only by resetting the watchdog.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>l4wd_wdt_cr_wdt_en_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>rmod</name>
       <description>Selects the output response generated to a timeout.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>l4wd_wdt_cr_rmod_enum</name>
         <enumeratedValue>
          <name>rst</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>irqrst</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>wdt_torr</name>
