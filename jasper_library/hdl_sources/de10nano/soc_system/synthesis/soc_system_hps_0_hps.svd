       <msb>7</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>partition</name>
       <description>if set, Partition logic is present in hardware. </description>
       <lsb>8</lsb>
       <msb>8</msb>
       <access>read-only</access>
