         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>smplsel</name>
       <description>Select which phase shift of the clock for cclk_in_sample.</description>
       <lsb>3</lsb>
       <msb>5</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>sysmgr_sdmmcgrp_ctrl_smplsel_enum</name>
         <enumeratedValue>
