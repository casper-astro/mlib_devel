       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>gpi</name>
     <description>Provides a low-latency, low-performance, and simple way to read general-purpose signals driven from the FPGA fabric.</description>
     <addressOffset>0x14</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <fields>
      <field>
       <name>value</name>
