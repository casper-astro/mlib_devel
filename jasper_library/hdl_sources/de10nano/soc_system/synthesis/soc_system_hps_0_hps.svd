     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>value0</name>
       <description>[list][*]00 - Bank 0 is in Main mode [*]01 - Bank 0 is in Spare mode [*]10 - Bank 0 is in Main+Spare mode[/list]</description>
       <lsb>0</lsb>
       <msb>1</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>value1</name>
       <description>[list][*]00 - Bank 1 is in Main mode [*]01 - Bank 1 is in Spare mode [*]10 - Bank 1 is in Main+Spare mode[/list]</description>
       <lsb>2</lsb>
       <msb>3</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>value2</name>
       <description>[list][*]00 - Bank 2 is in Main mode [*]01 - Bank 2 is in Spare mode [*]10 - Bank 2 is in Main+Spare mode[/list]</description>
       <lsb>4</lsb>
       <msb>5</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>value3</name>
