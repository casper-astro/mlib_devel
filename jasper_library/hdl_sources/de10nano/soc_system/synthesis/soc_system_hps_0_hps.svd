         </enumeratedValue>
         <enumeratedValue>
          <name>endpt11</name>
          <value>11</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt12</name>
          <value>12</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt13</name>
          <value>13</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt14</name>
          <value>14</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>endpt15</name>
          <value>15</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>epdir</name>
       <description>Indicates whether the transaction is IN or OUT.</description>
       <lsb>15</lsb>
       <msb>15</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>usb_hostgrp_hcchar10_epdir_enum</name>
         <enumeratedValue>
          <name>out</name>
