    <register>
     <name>txoicr</name>
     <description>Transmit FIFO Overflow Interrupt Clear Register</description>
     <addressOffset>0x38</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>txoicr</name>
       <description>This register reflects the status of the interrupt. A read from this register clears the spi_txo_intr interrupt; writing has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rxoicr</name>
     <description>Receive FIFO Overflow Interrupt Clear Register</description>
     <addressOffset>0x3c</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rxoicr</name>
       <description>This register reflects the status of the interrupt. A read from this register clears the spi_rxo_intr interrupt; writing has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rxuicr</name>
     <description>Receive FIFO Underflow Interrupt Clear Register</description>
     <addressOffset>0x40</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rxuicr</name>
       <description>This register reflects the status of the interrupt. A read from this register clears the spi_rxu_intr interrupt; writing has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>icr</name>
     <description>Clear Interrupt </description>
     <addressOffset>0x48</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>icr</name>
       <description>This register is set if any of the interrupts are active. A read clears the spi_txo_intr, spi_rxu_intr, spi_rxo_intr, and the spi_mst_intr interrupts. Writing to this register has no effect.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>dmacr</name>
     <description>This register is used to enable the DMA Controller interface operation.</description>
     <addressOffset>0x4c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rdmae</name>
       <description>This bit enables/disables the receive FIFO DMA channel.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spim_dmacr_rdmae_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>tdmae</name>
       <description>This bit enables/disables the transmit FIFO DMA channel.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>spim_dmacr_tdmae_enum</name>
         <enumeratedValue>
          <name>disabled</name>
          <value>0x0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enabled</name>
          <value>0x1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>dmatdlr</name>
     <description>Controls the FIFO Level for a DMA transmit request</description>
     <addressOffset>0x50</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dmatdl</name>
       <description>This bit field controls the level at which a DMA request is made by the transmit logic. It is equal to the watermark level; that is, the dma_tx_req signal is generated when the number of valid data entries in the transmit FIFO is equal to or below this field value, and TDMAE = 1.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>dmardlr</name>
     <description>Controls the FIFO Level for a DMA receeive request</description>
     <addressOffset>0x54</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dmardl</name>
       <description>This bit field controls the level at which a DMA request is made by the receive logic. The watermark level = DMARDL+1; that is, dma_rx_req is generated when the number of valid data entries in the receive FIFO is equal to or above this field value + 1, and RDMAE=1.</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>idr</name>
     <description>This register contains the peripherals identification code, which is 0x05510000.</description>
     <addressOffset>0x58</addressOffset>
     <size>32</size>
     <access>read-only</access>
     <resetValue>0x5510000</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>idr</name>
       <description>This register contains the peripherals identification code</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-only</access>
      </field>
     </fields>
    </register>
    <register>
     <name>spi_version_id</name>
     <description>Version ID Register value</description>
     <addressOffset>0x5c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x3332302a</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>spi_version_id</name>
       <description>Contains the hex representation of the Synopsys component version. Consists of ASCII value for each number in the version.</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>dr</name>
     <description>This register is a 16-bit read/write buffer for the transmit/receive FIFOs. When the register is read, data in the receive FIFO buffer is accessed. When it is written to, data are moved into the transmit FIFO buffer; a write can occur only when SPI_EN = 1. FIFOs are reset when SPI_EN = 0.
The data register occupies 36 32-bit locations in the address map (0x60 to 0xec). These are all aliases for the same data register. This is done to support burst accesses.</description>
     <addressOffset>0x60</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>dr</name>
       <description>When writing to this register, you must right-justify the data. Read data are automatically right-justified.
Read = Receive FIFO buffer
Write = Transmit FIFO buffer</description>
       <lsb>0</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>rx_sample_dly</name>
     <description>This register controls the number of spi_m_clk cycles that are delayed (from the default sample time) before the actual sample of the rxd input occurs. It is impossible to write to this register when the SPI Master is enabled. The SPI Master is enabled and disabled by writing to the SPIENR register.</description>
     <addressOffset>0xfc</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>rsd</name>
       <description>This register is used to delay the sample of the rxd input port. Each value represents a single spi_m_clk delay on the sample of rxd.
Note; If this register is programmed with a value that exceeds 64, a 0 delay will be applied to the receive sample. The maximum delay is 64 spi_m_clk cycles.</description>
       <lsb>0</lsb>
       <msb>6</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
   </registers>
  </peripheral>
  <peripheral>
   <name>scanmgr</name>
   <version>0.0</version>
   <description>Registers in the Scan Manager module.

These registers are implemented by an ARM JTAG-AP module from the ARM DAP. Some register and field names have been changed to match the usage in the Scan Manager. If modified, the corresponding names from the ARM documentation are provided. Only registers and fields that are relevant to the JTAG-AP use in the Scan Manager are listed.</description>
   <disableCondition>(Peripherals-&gt;rstmgr-&gt;rstmgr_miscmodrst-&gt;scanmgr == 1)</disableCondition><baseAddress>0xfff02000</baseAddress>
   <access>read-write</access>
   <addressBlock>
    <offset>0x0</offset>
    <size>0x20</size>
    <usage>registers</usage>
   </addressBlock>
   <registers>
    <register>
     <name>stat</name>
     <description>Consist of control bit and status information.</description>
     <addressOffset>0x0</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xfffffff7</resetMask>
     <fields>
      <field>
       <name>trst</name>
       <description>Specifies the value of the nTRST signal driven to the FPGA JTAG only. The FPGA JTAG scan-chain must be enabled via the EN register to drive the value specified in this field. The nTRST signal is driven with the inverted value of this field.The nTRST signal is active low so, when this bit is set to 1, FPGA JTAG is reset.

The name of this field in ARM documentation is TRST_OUT.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>scanmgr_stat_trst_enum</name>
         <enumeratedValue>
          <name>dont_reset_fpga_jtag</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>reset_fpga_jtag</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ignore</name>
       <description>Ignore this field. Its value is undefined (may be 0 or 1).

The name of this field in ARM documentation is PORTCONNECTED.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>rfifocnt</name>
       <description>Response FIFO outstanding byte count. Returns the number of bytes of response data available in the Response FIFO.
</description>
       <lsb>24</lsb>
       <msb>26</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>wfifocnt</name>
       <description>Command FIFO outstanding byte count. Returns the number of command bytes held in the Command FIFO that have yet to be processed by the Scan-Chain Engine.
</description>
       <lsb>28</lsb>
       <msb>30</msb>
       <access>read-only</access>
      </field>
      <field>
       <name>active</name>
       <description>Indicates if the Scan-Chain Engine is processing commands from the Command FIFO or not.
The Scan-Chain Engine is only guaranteed to be inactive if both the ACTIVE and WFIFOCNT fields are zero.

The name of this field in ARM documentation is SERACTV.</description>
       <lsb>31</lsb>
       <msb>31</msb>
       <access>read-only</access>
       <enumeratedValues>
        <name>scanmgr_stat_active_enum</name>
         <enumeratedValue>
          <name>possibly_inactive</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>active</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>en</name>
     <description>This register is used to enable one of the 5 scan-chains (0-3 and 7). Only one scan-chain must be enabled at a time. A scan-chain is enabled by writing its corresponding enable field.
Software must use the System Manager to put the corresponding I/O scan-chain into the frozen state before attempting to send I/O configuration data to the I/O scan-chain.
Software must only write to this register when the Scan-Chain Engine is inactive.Writing this field at any other time has unpredictable results. This means that before writing to this field, software must read the STAT register and check that the ACTIVE and WFIFOCNT fields are both zero.

The name of this register in ARM documentation is PSEL.</description>
     <addressOffset>0x4</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>ioscanchain0</name>
       <description>Used to enable or disable I/O Scan-Chain 0

The name of this field in ARM documentation is PSEL0.</description>
       <lsb>0</lsb>
       <msb>0</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>scanmgr_en_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ioscanchain1</name>
       <description>Used to enable or disable I/O Scan-Chain 1

The name of this field in ARM documentation is PSEL1.</description>
       <lsb>1</lsb>
       <msb>1</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>scanmgr_en_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ioscanchain2</name>
       <description>Used to enable or disable I/O Scan-Chain 2

The name of this field in ARM documentation is PSEL2.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>scanmgr_en_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>ioscanchain3</name>
       <description>Used to enable or disable I/O Scan-Chain 3

The name of this field in ARM documentation is PSEL3.</description>
       <lsb>3</lsb>
       <msb>3</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>scanmgr_en_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>fpgajtag</name>
       <description>Used to enable or disable FPGA JTAG scan-chain.Software must use the System Manager to enable the Scan Manager to drive the FPGA JTAG before attempting to communicate with the FPGA JTAG via the Scan Manager.

The name of this field in ARM documentation is PSEL7.</description>
       <lsb>7</lsb>
       <msb>7</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>scanmgr_en_enum</name>
         <enumeratedValue>
          <name>disable</name>
          <value>0</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>enable</name>
          <value>1</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
     </fields>
    </register>
    <register>
     <name>fifosinglebyte</name>
     <description>Writes to the FIFO Single Byte Register write a single byte value to the command FIFO.  If the command FIFO is full, the APB write operation is stalled until the command FIFO is not full.
Reads from the Single Byte FIFO Register read a single byte value from the command FIFO.  If the command FIFO is empty, the APB read operation is stalled until the command FIFO is not empty.

See the ARM documentation for a description of the read and write values.

The name of this register in ARM documentation is BWFIFO1 for writes and BRFIFO1 for reads.</description>
     <addressOffset>0x10</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffffff00</resetMask>
     <fields>
      <field>
       <name>value</name>
       <description>Transfers single byte value to/from command FIFO</description>
       <lsb>0</lsb>
       <msb>7</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>fifodoublebyte</name>
     <description>Writes to the FIFO Double Byte Register write a double byte value to the command FIFO.  If the command FIFO is full, the APB write operation is stalled until the command FIFO is not full.
Reads from the Double Byte FIFO Register read a double byte value from the command FIFO.  If the command FIFO is empty, the APB read operation is stalled until the command FIFO is not empty.

See the ARM documentation for a description of the read and write values.

The name of this register in ARM documentation is BWFIFO2 for writes and BRFIFO2 for reads.</description>
     <addressOffset>0x14</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xffff0000</resetMask>
     <fields>
      <field>
       <name>value</name>
       <description>Transfers double byte value to/from command FIFO</description>
       <lsb>0</lsb>
       <msb>15</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>fifotriplebyte</name>
     <description>Writes to the FIFO Triple Byte Register write a triple byte value to the command FIFO.  If the command FIFO is full, the APB write operation is stalled until the command FIFO is not full.
Reads from the Triple Byte FIFO Register read a triple byte value from the command FIFO.  If the command FIFO is empty, the APB read operation is stalled until the command FIFO is not empty.

See the ARM documentation for a description of the read and write values.

The name of this register in ARM documentation is BWFIFO3 for writes and BRFIFO3 for reads.</description>
     <addressOffset>0x18</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <resetValue>0x0</resetValue>
     <resetMask>0xff000000</resetMask>
     <fields>
      <field>
       <name>value</name>
       <description>Transfers triple byte value to/from command FIFO</description>
       <lsb>0</lsb>
       <msb>23</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
    <register>
     <name>fifoquadbyte</name>
     <description>Writes to the FIFO Quad Byte Register write a quad byte value to the command FIFO.  If the command FIFO is full, the APB write operation is stalled until the command FIFO is not full.
Reads from the Quad Byte FIFO Register read a quad byte value from the command FIFO.  If the command FIFO is empty, the APB read operation is stalled until the command FIFO is not empty.

See the ARM documentation for a description of the read and write values.

The name of this register in ARM documentation is BWFIFO4 for writes and BRFIFO4 for reads.</description>
     <addressOffset>0x1c</addressOffset>
     <size>32</size>
     <access>read-write</access>
     <fields>
      <field>
       <name>value</name>
       <description>Transfers quad byte value to/from command FIFO</description>
       <lsb>0</lsb>
       <msb>31</msb>
       <access>read-write</access>
      </field>
     </fields>
    </register>
