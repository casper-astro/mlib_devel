          <value>0</value>
         </enumeratedValue>
       </enumeratedValues>
      </field>
      <field>
       <name>fbe</name>
       <description>When set with Abnormal Interrupt Summary Enable, the Fatal Bus Error Interrupt is enabled.</description>
       <lsb>2</lsb>
       <msb>2</msb>
       <access>read-write</access>
       <enumeratedValues>
        <name>sdmmc_idinten_fbe_enum</name>
         <enumeratedValue>
