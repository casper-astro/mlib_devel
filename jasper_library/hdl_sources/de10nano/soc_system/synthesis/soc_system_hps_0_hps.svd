         </enumeratedValue>
         <enumeratedValue>
          <name>trans4</name>
          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>trans8</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
