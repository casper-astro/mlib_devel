     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>gdfifocfg</name>
       <description>This field is for dynamic programming of the DFIFO Size. This value takes effect only when the application programs a non zero value to this register. The otg core does not have any corrective logic if the FIFO sizes are programmed incorrectly.</description>
       <lsb>0</lsb>
       <msb>15</msb>
       <access>read-write</access>
