          <value>1</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>descrd</name>
          <value>2</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>descchk</name>
          <value>3</value>
         </enumeratedValue>
         <enumeratedValue>
          <name>dmardreqwait</name>
          <value>4</value>
         </enumeratedValue>
         <enumeratedValue>
