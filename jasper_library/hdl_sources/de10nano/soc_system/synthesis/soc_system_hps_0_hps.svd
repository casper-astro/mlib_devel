     <resetMask>0xffffffff</resetMask>
     <fields>
      <field>
       <name>encoded_id_pwidth_a</name>
       <description>Specifies the width of GPIO Port A. The value 28 represents the 29-bit width less one.</description>
       <lsb>0</lsb>
       <msb>4</msb>
       <access>read-only</access>
