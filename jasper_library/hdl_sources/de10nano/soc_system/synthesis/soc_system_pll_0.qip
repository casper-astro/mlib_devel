set_instance_assignment -name PLL_COMPENSATION_MODE "NORMAL" -to "*soc_system_pll_0*|altera_pll:altera_pll_i*|*"
 
set_instance_assignment -name PLL_AUTO_RESET OFF -to "*soc_system_pll_0*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*soc_system_pll_0*|altera_pll:altera_pll_i*|*"
