    <widget class="QLabel" name="desc_label"/>
   </widget>
   <widget class="QLabel" name="label_name">
    <property name="text"><string>Block name</string></property>
   </widget>
   <widget class="QLineEdit" name="name"/>
   <widget class="QTabWidget" name="tabWidget">
    <widget class="QWidget" name="inputs_tab">
     <attribute name="title"><string>Inputs</string></attribute>
