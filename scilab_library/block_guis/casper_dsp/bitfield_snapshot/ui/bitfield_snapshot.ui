 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="windowTitle"><string>Block Parameters: bitfield_snapshot</string></property>
  <widget class="QWidget" name="centralwidget">
   <!-- NOTE: this is a simplified structural mirror of bitfield_snapshot_ui.py, not a full
        round-trip Designer file; it follows the casper_library_scopes bitfield_snapshot (bitsnap)
        mask. Edit both together. -->
